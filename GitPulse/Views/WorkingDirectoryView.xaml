<UserControl x:Class="GitPulse.Views.WorkingDirectoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:GitPulse.Converters">
    <UserControl.Resources>
        <conv:FileStatusToColorConverter x:Key="StatusToColor"/>
        <conv:FileStatusToIconConverter x:Key="StatusToIcon"/>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="CHANGES" FontSize="11" FontWeight="SemiBold"
                   Foreground="#9399B2" Padding="12,8" />

        <ListBox Grid.Row="1" ItemsSource="{Binding Files}"
                 SelectedItem="{Binding SelectedFile, Mode=TwoWay}"
                 Background="Transparent" BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Padding="8,4" Margin="0,1,8,1"
                            CornerRadius="4" Background="Transparent">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <CheckBox IsChecked="{Binding IsStaged}"
                                      Command="{Binding DataContext.ToggleStageCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}"
                                      CommandParameter="{Binding}"
                                      Foreground="#89B4FA" Margin="0,0,8,0"/>

                            <TextBlock Grid.Column="1" Text="{Binding Status, Converter={StaticResource StatusToIcon}}"
                                       Foreground="{Binding Status, Converter={StaticResource StatusToColor}}"
                                       FontFamily="Consolas" FontSize="11"
                                       Width="16" TextAlignment="Center"/>

                            <TextBlock Grid.Column="2" Text="{Binding FilePath}"
                                       Foreground="#CDD6F4" FontSize="13"
                                       Margin="6,0,0,0" TextTrimming="CharacterEllipsis"/>

                            <TextBlock Grid.Column="3" Text="{Binding Status}"
                                       Foreground="{Binding Status, Converter={StaticResource StatusToColor}}"
                                       FontSize="10" Margin="4,0"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
