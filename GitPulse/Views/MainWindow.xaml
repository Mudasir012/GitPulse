<Window x:Class="GitPulse.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:GitPulse.ViewModels"
        xmlns:views="clr-namespace:GitPulse.Views"
        Title="GitPulse" Width="1200" Height="800"
        Background="#1E1E2E" Foreground="#CDD6F4"
        WindowStartupLocation="CenterScreen">
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="120"/>
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border BorderBrush="#3B3B5C" BorderThickness="0,0,0,1" Background="#252540">
            <Grid Margin="8,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="GitPulse" FontSize="15" FontWeight="Bold" 
                           Foreground="#89B4FA" Margin="8,0,16,0" VerticalAlignment="Center"/>

                <Button Grid.Column="1" Content="Open" Command="{Binding OpenRepoCommand}"
                        Style="{StaticResource SmallButtonStyle}" Width="60"/>
                <Button Grid.Column="2" Content="Clone" Command="{Binding CloneRepoCommand}"
                        Style="{StaticResource SmallButtonStyle}" Width="60"/>
                <Button Grid.Column="3" Content="Push" Command="{Binding PushCommand}"
                        Style="{StaticResource SmallButtonStyle}" Width="60"/>
                <Button Grid.Column="4" Content="Pull" Command="{Binding PullCommand}"
                        Style="{StaticResource SmallButtonStyle}" Width="60"/>
                <Button Grid.Column="5" Content="Fetch" Command="{Binding FetchCommand}"
                        Style="{StaticResource SmallButtonStyle}" Width="60"/>

                <StackPanel Grid.Column="7" Orientation="Horizontal" VerticalAlignment="Center">
                    <ProgressBar IsIndeterminate="True" Width="80" Margin="0,0,8,0"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"
                                 Foreground="#89B4FA" Background="#2D2D44" BorderThickness="0"/>
                    <TextBlock Text="{Binding ProgressText}" FontSize="11" Foreground="#9399B2" Margin="0,0,8,0"
                               Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <TextBlock Text="{Binding CurrentBranch}" FontSize="12" FontWeight="SemiBold"
                               Foreground="#89B4FA" Margin="0,0,8,0"
                               Visibility="{Binding IsRepoOpen, Converter={StaticResource BoolToVisibilityConverter}}"/>
                    <TextBlock Text="{Binding RepoPath}" FontSize="11" Foreground="#585B70"
                               TextTrimming="CharacterEllipsis" MaxWidth="300"
                               Visibility="{Binding IsRepoOpen, Converter={StaticResource BoolToVisibilityConverter}}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border BorderBrush="#3B3B5C" BorderThickness="0,0,1,0" Background="#252540">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="REPOSITORY" FontSize="11" FontWeight="SemiBold"
                               Foreground="#9399B2" Padding="12,8"/>
                    <views:BranchesView Grid.Row="1" DataContext="{Binding Branches}"/>
                </Grid>
            </Border>

            <!-- Center -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Tab bar -->
                <Border BorderBrush="#3B3B5C" BorderThickness="0,0,0,1" Background="#252540">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Button Content="Changes" Command="{Binding SwitchToChangesCommand}"
                                Style="{StaticResource TabButtonStyle}"
                                Foreground="{Binding ActiveTab, Converter={StaticResource TabActiveColorConverter}, ConverterParameter=changes}"/>
                        <Button Grid.Column="1" Content="History" Command="{Binding SwitchToHistoryCommand}"
                                Style="{StaticResource TabButtonStyle}"
                                Foreground="{Binding ActiveTab, Converter={StaticResource TabActiveColorConverter}, ConverterParameter=history}"/>
                    </Grid>
                </Border>

                <!-- Changes tab content -->
                <Grid Grid.Row="1" Visibility="{Binding ActiveTab, Converter={StaticResource TabToVisibilityConverter}, ConverterParameter=changes}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="3"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <views:WorkingDirectoryView DataContext="{Binding WorkingDirectory}"/>

                    <GridSplitter Grid.Row="1" Background="#3B3B5C" Height="3"
                                  HorizontalAlignment="Stretch" Cursor="SizeNS"/>

                    <views:DiffView Grid.Row="2" DataContext="{Binding Diff}"/>
                </Grid>

                <!-- History tab content -->
                <views:CommitGraphView Grid.Row="1"
                                       DataContext="{Binding CommitGraph}"
                                       Visibility="{Binding ActiveTab, Converter={StaticResource TabToVisibilityConverter}, ConverterParameter=history}"/>
            </Grid>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="2" BorderBrush="#3B3B5C" BorderThickness="0,1,0,0"
                Background="#1E1E2E" Padding="12,4">
            <TextBlock Text="{Binding RepoPath, StringFormat='Repo: {0}'}"
                       FontSize="11" Foreground="#585B70"
                       Visibility="{Binding IsRepoOpen, Converter={StaticResource BoolToVisibilityConverter}}"/>
        </Border>

        <!-- Commit Box -->
        <views:CommitBoxView Grid.Row="3" DataContext="{Binding CommitBox}"/>
    </Grid>
</Window>
