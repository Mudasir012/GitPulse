<Window x:Class="GitPulse.Views.MergeConflictView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Merge Conflicts" Width="560" Height="390"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBaseBrush}" Foreground="{StaticResource TextBrush}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
            <Border Width="24" Height="24" CornerRadius="12" Background="#3B181A" Margin="0,0,10,0">
                <Path Data="M 12 2 L 22 20 L 2 20 Z M 12 8 L 12 14 M 12 17 L 12 18" Stroke="{StaticResource RedBrush}" StrokeThickness="1.5" Stretch="Uniform" Margin="5" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Border>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Resolve Merge Conflicts" FontSize="15" FontWeight="Bold" Foreground="{StaticResource RedBrush}"/>
                <TextBlock Text="Select a conflicted file and choose resolution strategy" FontSize="11" Foreground="{StaticResource TextDimBrush}"/>
            </StackPanel>
        </StackPanel>

        <ListBox Grid.Row="1" ItemsSource="{Binding ConflictFiles}"
                 SelectedItem="{Binding SelectedFile, Mode=TwoWay}"
                 Background="{StaticResource BgInsetBrush}" BorderBrush="{StaticResource BorderStrongBrush}"
                 BorderThickness="1" Foreground="{StaticResource TextBrush}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Padding="10,6" Margin="2,1" CornerRadius="4">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border CornerRadius="3" Background="#332A15" Padding="5,1" Margin="0,0,8,0">
                                <TextBlock Text="CONFLICT" FontSize="9.5" FontWeight="Bold" Foreground="{StaticResource YellowBrush}"/>
                            </Border>
                            <TextBlock Grid.Column="1" Text="{Binding}" FontFamily="Consolas" FontSize="12"
                                       Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal">
                <Button Content="All Mine" Command="{Binding ResolveAllMineCommand}"
                        Style="{StaticResource SmallButtonStyle}" Padding="12,5"/>
                <Button Content="All Theirs" Command="{Binding ResolveAllTheirsCommand}"
                        Style="{StaticResource SmallButtonStyle}" Padding="12,5"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Accept Mine" Command="{Binding AcceptMineCommand}"
                        Width="110" Height="32"
                        Background="#162D1D" Foreground="{StaticResource GreenBrush}"
                        BorderBrush="{StaticResource GreenBrush}" BorderThickness="1"
                        FontSize="11.5" FontWeight="SemiBold" Cursor="Hand" Margin="0,0,8,0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button Content="Accept Theirs" Command="{Binding AcceptTheirsCommand}"
                        Width="110" Height="32"
                        Background="#35191B" Foreground="{StaticResource RedBrush}"
                        BorderBrush="{StaticResource RedBrush}" BorderThickness="1"
                        FontSize="11.5" FontWeight="SemiBold" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
