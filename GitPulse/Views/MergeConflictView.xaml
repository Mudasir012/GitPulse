<Window x:Class="GitPulse.Views.MergeConflictView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Merge Conflicts" Width="520" Height="360"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBaseBrush}" Foreground="{StaticResource TextBrush}">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Resolve Merge Conflicts" FontSize="16" FontWeight="SemiBold"
                   Foreground="{StaticResource RedBrush}" Margin="0,0,0,12"/>

        <ListBox Grid.Row="1" ItemsSource="{Binding ConflictFiles}"
                 SelectedItem="{Binding SelectedFile, Mode=TwoWay}"
                 Background="{StaticResource BgInsetBrush}" BorderBrush="{StaticResource BorderBrush}"
                 Foreground="{StaticResource TextBrush}" FontSize="13">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="12"
                               Foreground="{StaticResource YellowBrush}" Padding="6,3"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Accept Mine" Command="{Binding AcceptMineCommand}"
                    Width="105" Height="32"
                    Background="Transparent" Foreground="{StaticResource GreenBrush}"
                    BorderBrush="{StaticResource GreenBrush}" BorderThickness="1"
                    FontSize="12" Cursor="Hand" Margin="0,0,8,0"/>
            <Button Content="Accept Theirs" Command="{Binding AcceptTheirsCommand}"
                    Width="105" Height="32"
                    Background="Transparent" Foreground="{StaticResource RedBrush}"
                    BorderBrush="{StaticResource RedBrush}" BorderThickness="1"
                    FontSize="12" Cursor="Hand" Margin="0,0,8,0"/>
            <Button Content="All Mine" Command="{Binding ResolveAllMineCommand}"
                    Style="{StaticResource SmallButtonStyle}" FontSize="12"/>
            <Button Content="All Theirs" Command="{Binding ResolveAllTheirsCommand}"
                    Style="{StaticResource SmallButtonStyle}" FontSize="12"/>
        </StackPanel>
    </Grid>
</Window>
