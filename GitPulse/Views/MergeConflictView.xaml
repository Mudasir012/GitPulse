<Window x:Class="GitPulse.Views.MergeConflictView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Merge Conflicts" Width="500" Height="350"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E2E" Foreground="#CDD6F4">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Resolve Merge Conflicts" FontSize="16" FontWeight="SemiBold"
                   Foreground="#F38BA8" Margin="0,0,0,12"/>

        <ListBox Grid.Row="1" ItemsSource="{Binding ConflictFiles}"
                 SelectedItem="{Binding SelectedFile, Mode=TwoWay}"
                 Background="#2D2D44" BorderBrush="#3B3B5C"
                 Foreground="#CDD6F4" FontSize="13">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding}" FontFamily="Consolas" FontSize="12"
                               Foreground="#F9E2AF" Padding="4,2"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Accept Mine" Command="{Binding AcceptMineCommand}"
                    Width="110" Height="32"
                    Background="Transparent" Foreground="#A6E3A1"
                    BorderBrush="#A6E3A1" BorderThickness="1"
                    FontSize="12" Cursor="Hand" Margin="0,0,8,0"/>
            <Button Content="Accept Theirs" Command="{Binding AcceptTheirsCommand}"
                    Width="110" Height="32"
                    Background="Transparent" Foreground="#F38BA8"
                    BorderBrush="#F38BA8" BorderThickness="1"
                    FontSize="12" Cursor="Hand" Margin="0,0,8,0"/>
            <Button Content="All Mine" Command="{Binding ResolveAllMineCommand}"
                    Style="{StaticResource SmallButtonStyle}"/>
            <Button Content="All Theirs" Command="{Binding ResolveAllTheirsCommand}"
                    Style="{StaticResource SmallButtonStyle}"/>
        </StackPanel>
    </Grid>
</Window>
