<UserControl x:Class="GitPulse.Views.DiffView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:GitPulse.Converters">
    <UserControl.Resources>
        <conv:DiffLineTypeToColorConverter x:Key="LineTypeToColor"/>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="14,8" Background="{StaticResource BgPanelBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="DIFF" FontSize="11" FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center"/>
                <Border Grid.Column="1" Background="{StaticResource BgInsetBrush}"
                        CornerRadius="4" Padding="7,2" Margin="10,0,0,0"
                        BorderBrush="{StaticResource BorderStrongBrush}" BorderThickness="1"
                        Visibility="{Binding HasDiff, Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="{Binding FileName}"
                               FontSize="11" Foreground="{StaticResource AccentBrush}"
                               FontFamily="Consolas" FontWeight="Medium"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                </Border>
            </Grid>
        </Border>

        <ListBox Grid.Row="1" ItemsSource="{Binding DiffLines}"
                 Background="Transparent" BorderThickness="0"
                 VirtualizingPanel.ScrollUnit="Pixel"
                 FontFamily="Consolas"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="{Binding Type, Converter={StaticResource LineTypeToColor}}"
                            Padding="14,2,14,2">
                        <TextBlock Text="{Binding Text}" FontSize="12.5"
                                   Foreground="{StaticResource TextBrush}"/>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="{Binding HasDiff, Converter={StaticResource InvertedBoolToVisibilityConverter}}">
            <Border Width="36" Height="36" CornerRadius="18" Background="{StaticResource BgInsetBrush}" Margin="0,0,0,8">
                <Path Data="M 4 4 L 16 4 L 16 16 L 4 16 Z M 8 8 L 12 8 M 8 12 L 12 12" Stroke="{StaticResource TextDimBrush}" StrokeThickness="1.5" Stretch="Uniform" Margin="8" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Border>
            <TextBlock Text="Select a file to inspect diff"
                       Foreground="{StaticResource TextDimBrush}" FontSize="12"
                       HorizontalAlignment="Center"/>
        </StackPanel>
    </Grid>
</UserControl>
