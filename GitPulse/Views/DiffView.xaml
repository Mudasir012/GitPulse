<UserControl x:Class="GitPulse.Views.DiffView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:GitPulse.Converters">
    <UserControl.Resources>
        <conv:DiffLineTypeToColorConverter x:Key="LineTypeToColor"/>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                Padding="14,7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="DIFF" FontSize="11" FontWeight="SemiBold"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="{Binding FileName}"
                           FontSize="11" Foreground="{StaticResource TextDimBrush}"
                           FontFamily="Consolas"
                           VerticalAlignment="Center" Margin="10,0,0,0"
                           TextTrimming="CharacterEllipsis"/>
            </Grid>
        </Border>

        <ListBox Grid.Row="1" ItemsSource="{Binding DiffLines}"
                 Background="Transparent" BorderThickness="0"
                 VirtualizingPanel.ScrollUnit="Pixel"
                 FontFamily="Consolas"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="{Binding Type, Converter={StaticResource LineTypeToColor}}"
                            Padding="12,1,12,1">
                        <TextBlock Text="{Binding Text}" FontSize="12"
                                   Foreground="{StaticResource TextBrush}"/>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock Grid.Row="1" Text="Select a file to view diff"
                   Visibility="{Binding HasDiff, Converter={StaticResource InvertedBoolToVisibilityConverter}}"
                   Foreground="{StaticResource TextDimBrush}" FontSize="12"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Grid>
</UserControl>
