<UserControl x:Class="GitPulse.Views.DiffView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:GitPulse.Converters">
    <UserControl.Resources>
        <conv:DiffLineTypeToColorConverter x:Key="LineTypeToColor"/>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border BorderBrush="#3B3B5C" BorderThickness="0,0,0,1"
                Padding="12,6">
            <TextBlock Text="{Binding FileName, StringFormat='Diff: {0}'}"
                       FontSize="12" FontWeight="SemiBold" Foreground="#9399B2"/>
        </Border>

        <ListBox Grid.Row="1" ItemsSource="{Binding DiffLines}"
                 Background="Transparent" BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="{Binding Type, Converter={StaticResource LineTypeToColor}}"
                            Padding="8,1,0,1">
                        <TextBlock Text="{Binding Text}" FontFamily="Consolas" FontSize="12"
                                   Foreground="#CDD6F4"/>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock Grid.Row="1" Text="Select a file to view diff"
                   Visibility="{Binding HasDiff, Converter={StaticResource InvertedBoolToVisibilityConverter}}"
                   Foreground="#9399B2" FontSize="13"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Grid>
</UserControl>
