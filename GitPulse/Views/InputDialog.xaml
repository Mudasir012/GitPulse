<Window x:Class="GitPulse.Views.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Input" Width="420" Height="165"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBaseBrush}" Foreground="{StaticResource TextBrush}"
        ResizeMode="NoResize">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="PromptText" Text="Enter value:" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}"/>
        <TextBox Grid.Row="1" x:Name="InputBox"
                 Margin="0,10" VerticalAlignment="Top"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Click="Cancel_Click" IsCancel="True"
                    Width="80" Height="32"
                    Style="{StaticResource SmallButtonStyle}" FontSize="12"/>
            <Button Content="OK" Click="Ok_Click" IsDefault="True"
                    Width="80" Margin="8,0,0,0"
                    Style="{StaticResource PrimaryButtonStyle}"/>
        </StackPanel>
    </Grid>
</Window>
