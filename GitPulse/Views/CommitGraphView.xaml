<UserControl x:Class="GitPulse.Views.CommitGraphView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:GitPulse.Converters">
    <UserControl.Resources>
        <conv:HexToBrushConverter x:Key="HexToBrush"/>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border BorderBrush="#3B3B5C" BorderThickness="0,0,0,1" Padding="12,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="HISTORY" FontSize="11" FontWeight="SemiBold" Foreground="#9399B2"/>
                <Grid Grid.Column="1" Margin="0,0,8,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="11" Padding="4,2" Width="160"
                             VerticalContentAlignment="Center"
                             Background="#2D2D44" Foreground="#CDD6F4"
                             BorderBrush="#3B3B5C" BorderThickness="1"/>
                    <Button Grid.Column="1" Content="Search" Command="{Binding SearchCommand}"
                            Style="{StaticResource SmallButtonStyle}" Margin="4,0,0,0"/>
                </Grid>
            </Grid>
        </Border>

        <ListBox Grid.Row="1" ItemsSource="{Binding Commits}"
                 Background="Transparent" BorderThickness="0"
                 VirtualizingPanel.ScrollUnit="Pixel"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Padding="8,4" Margin="0,0,8,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <ItemsControl ItemsSource="{Binding Segments}"
                                          Margin="0,0,8,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Text}"
                                                   FontFamily="Consolas" FontSize="13"
                                                   Foreground="{Binding Color, Converter={StaticResource HexToBrush}}"
                                                   LineHeight="20"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Grid.Column="1" VerticalAlignment="Center">
                                <Run Text="{Binding Commit.ShortSha}" FontFamily="Consolas"
                                     Foreground="#585B70" FontSize="11"/>
                                <Run Text=" " />
                                <Run Text="{Binding Commit.Message}" Foreground="#CDD6F4" FontSize="13"/>
                            </TextBlock>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                        Margin="8,0,0,0">
                                <Border Background="#2D2D44" CornerRadius="3"
                                        Padding="4,1" Margin="0,0,4,0"
                                        Visibility="{Binding BranchLabel, Converter={StaticResource NullToVisibilityConverter}}">
                                    <TextBlock Text="{Binding BranchLabel}"
                                               Foreground="{Binding BranchColor, Converter={StaticResource HexToBrush}}"
                                               FontSize="10" FontWeight="SemiBold"/>
                                </Border>
                                <TextBlock Text="{Binding Commit.TimeAgo}" Foreground="#585B70"
                                           FontSize="11"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
