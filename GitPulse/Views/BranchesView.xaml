<UserControl x:Class="GitPulse.Views.BranchesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:GitPulse.ViewModels">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ListBox ItemsSource="{Binding Branches}"
                 SelectedItem="{Binding SelectedBranch, Mode=TwoWay}"
                 Background="Transparent" BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Padding="10,5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Ellipse Width="7" Height="7" Fill="{StaticResource AccentBrush}"
                                     Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVisibilityConverter}}"
                                     VerticalAlignment="Center" Margin="0,0,9,0"/>
                            <TextBlock Grid.Column="1" Text="{Binding Name}"
                                       FontSize="13" Foreground="{StaticResource TextBrush}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Border Grid.Row="1" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Button Content="+ New Branch"
                    Command="{Binding CreateBranchCommand}"
                    Background="Transparent" Foreground="{StaticResource AccentBrush}"
                    BorderThickness="0" Padding="14,8"
                    FontSize="12" Cursor="Hand"
                    HorizontalContentAlignment="Left"/>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="10,2,10,8">
            <Button Content="Switch" Command="{Binding SwitchBranchCommand}"
                    Style="{StaticResource SmallButtonStyle}"/>
            <Button Content="Merge" Command="{Binding MergeBranchCommand}"
                    Style="{StaticResource SmallButtonStyle}"/>
            <Button Content="Delete" Command="{Binding DeleteBranchCommand}"
                    Style="{StaticResource SmallButtonStyle}"/>
        </StackPanel>
    </Grid>
</UserControl>
