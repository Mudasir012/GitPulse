<UserControl x:Class="GitPulse.Views.BranchesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:GitPulse.ViewModels">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ListBox ItemsSource="{Binding Branches}"
                 SelectedItem="{Binding SelectedBranch, Mode=TwoWay}"
                 Background="Transparent" BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Padding="8,4" Margin="0,1,8,1"
                            CornerRadius="4" Background="Transparent">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Ellipse Width="8" Height="8" Fill="#89B4FA" 
                                     Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVisibilityConverter}}"
                                     VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="1" Text="{Binding Name}"
                                       FontSize="13" Foreground="#CDD6F4"
                                       TextTrimming="CharacterEllipsis"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <Button Grid.Row="1" Content="+ New Branch" 
                Command="{Binding CreateBranchCommand}"
                Background="Transparent" Foreground="#89B4FA"
                BorderThickness="0" Padding="12,6"
                FontSize="12" Cursor="Hand"
                HorizontalContentAlignment="Left"/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="8,4">
            <Button Content="Switch" Command="{Binding SwitchBranchCommand}"
                    Style="{StaticResource SmallButtonStyle}"/>
            <Button Content="Merge" Command="{Binding MergeBranchCommand}"
                    Style="{StaticResource SmallButtonStyle}"/>
            <Button Content="Delete" Command="{Binding DeleteBranchCommand}"
                    Style="{StaticResource SmallButtonStyle}"/>
        </StackPanel>
    </Grid>
</UserControl>
