<UserControl x:Class="GitPulse.Views.CommitBoxView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
            Background="{StaticResource BgPanelBrush}">
        <Grid Margin="14,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox Text="{Binding CommitMessage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="False"
                     FontSize="13" Padding="10,7"
                     VerticalContentAlignment="Center"
                     x:Name="MessageBox"/>

            <Button Grid.Column="1" Content="Commit"
                    Command="{Binding CommitCommand}"
                    IsEnabled="{Binding CanCommit}"
                    Margin="10,0,0,0" Padding="20,0"
                    Style="{StaticResource PrimaryButtonStyle}"/>
        </Grid>
    </Border>
</UserControl>
