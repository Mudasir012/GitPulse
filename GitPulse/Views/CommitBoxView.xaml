<UserControl x:Class="GitPulse.Views.CommitBoxView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
            Background="{StaticResource BgPanelBrush}">
        <Grid Margin="14,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox Text="{Binding CommitMessage, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                     AcceptsReturn="False"
                     FontSize="13" Padding="12,8"
                     VerticalContentAlignment="Center"
                     x:Name="MessageBox"/>

            <Button Grid.Column="1"
                    Command="{Binding CommitCommand}"
                    IsEnabled="{Binding CanCommit}"
                    Margin="10,0,0,0" Padding="18,0"
                    Style="{StaticResource PrimaryButtonStyle}">
                <StackPanel Orientation="Horizontal">
                    <Path Data="M 6 2 A 4 4 0 0 0 6 10 A 4 4 0 0 0 6 2 Z M 6 10 L 6 18 M 6 10 A 4 4 0 0 0 10 14"
                          Stroke="#FFFFFFFF" StrokeThickness="1.5" Width="12" Height="12" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Commit" VerticalAlignment="Center" FontWeight="SemiBold"/>
                </StackPanel>
            </Button>
        </Grid>
    </Border>
</UserControl>
